{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_tokoyo-creator_tokoyo__begin_build",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/kit.mjs\" check",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/kit.mjs\" editor-sync --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
